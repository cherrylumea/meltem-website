# Sanity project connection.
# These two values are public (they are exposed to the browser by design)
# and are safe to commit in this example file.
NEXT_PUBLIC_SANITY_PROJECT_ID="bbltxsp1"
NEXT_PUBLIC_SANITY_DATASET="production"

# Optional. Pins the Sanity API to a specific date-based version.
# Defaults to the value in sanity/env.ts if omitted.
# NEXT_PUBLIC_SANITY_API_VERSION="2026-07-26"
